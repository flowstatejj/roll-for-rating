{
  "expo": {
    "name": "Roll for Rating",
    "slug": "jj-ladder",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8584796a-9507-4832-bcb7-c3c6d0c9d500"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rollcall",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.flowstatejj.rollforrating",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.flowstatejj.rollforrating",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-r4r-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1117",
          "image": "./assets/images/splash-r4r.png",
          "imageWidth": 180,
          "android": {
            "image": "./assets/images/splash-r4r.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Roll for Rating accesses your photo library so you can choose an existing video of your jiu-jitsu match and attach it to your fighter profile and the public Watch feed.",
          "cameraPermission": "Roll for Rating uses the camera so you can film a video of your jiu-jitsu match - for example, recording your roll to post on your fighter profile and share to the Watch feed.",
          "microphonePermission": "Roll for Rating uses the microphone to record sound while you film a match video - for example, capturing the audio of your roll so the clip you post to your profile and the Watch feed includes sound, not just silent video."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-iap",
      "@sentry/react-native",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#0d1117"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8584796a-9507-4832-bcb7-c3c6d0c9d500"
      }
    }
  }
}
