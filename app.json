{
  "expo": {
    "name": "Roll for Rating",
    "slug": "jj-ladder",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8584796a-9507-4832-bcb7-c3c6d0c9d500"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rollcall",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.flowstatejj.rollforrating",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.flowstatejj.rollforrating",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d1117",
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "android": {
            "image": "./assets/images/icon.png",
            "imageWidth": 160
          }
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Roll for Rating uses your photos so you can attach match videos.",
          "cameraPermission": "Roll for Rating uses your camera so you can record match videos.",
          "microphonePermission": "Roll for Rating uses your microphone to record audio with your match videos."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8584796a-9507-4832-bcb7-c3c6d0c9d500"
      }
    }
  }
}
